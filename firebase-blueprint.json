{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile with private details and public identifier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "publicId": { "type": "string" },
        "turma": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "points": { "type": "number" },
        "language": { "type": "string", "enum": ["pt", "en"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "publicId", "points", "language", "createdAt"]
    },
    "TurmasConfig": {
      "title": "TurmasConfig",
      "description": "Configurable list of classes for registration",
      "type": "object",
      "properties": {
        "list": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["list"]
    },
    "ThemeVisibilityConfig": {
      "title": "ThemeVisibilityConfig",
      "description": "Teacher controlled visibility flags for pedagogical themes",
      "type": "object",
      "properties": {
        "visibility": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["visibility"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Activity progress and quiz scores",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "activityId": { "type": "string" },
        "activityType": { "type": "string", "enum": ["module", "quiz", "challenge"] },
        "themeId": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "in_progress"] },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "percentage": { "type": "number" },
        "attempts": { "type": "number" },
        "bestScore": { "type": "number" },
        "bestPercentage": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["userId", "activityId", "activityType", "themeId", "status", "attempts", "lastUpdated"]
    },
    "UserAchievementDoc": {
      "title": "UserAchievementDoc",
      "description": "Unlocked badges and achievements",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "badgeId": { "type": "string" },
        "unlockedAt": { "type": "string" }
      },
      "required": ["userId", "badgeId", "unlockedAt"]
    },
    "PointTransactionDoc": {
      "title": "PointTransactionDoc",
      "description": "Audit log of points earned by student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "reason", "timestamp"]
    },
    "PublicLeaderboardProfile": {
      "title": "PublicLeaderboardProfile",
      "description": "Public anonymous leaderboard profile with minimal non-sensitive data for student privacy",
      "type": "object",
      "properties": {
        "publicId": { "type": "string" },
        "turma": { "type": "string" },
        "points": { "type": "number" }
      },
      "required": ["publicId", "points"]
    },
    "DailyTipAnswerDoc": {
      "title": "DailyTipAnswerDoc",
      "description": "Daily TIC Tip answer log for multi-device sync",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "answered": { "type": "boolean" },
        "selectedOptionId": { "type": "string" },
        "isCorrect": { "type": "boolean" },
        "pointsEarned": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "date", "answered", "pointsEarned", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile documents"
    },
    "/publicProfiles/{userId}": {
      "schema": "PublicLeaderboardProfile",
      "description": "Public anonymous leaderboard profile"
    },
    "/config/turmas": {
      "schema": "TurmasConfig",
      "description": "School class list configuration"
    },
    "/config/theme_visibility": {
      "schema": "ThemeVisibilityConfig",
      "description": "Pedagogical theme visibility settings controlled by teacher"
    },
    "/users/{userId}/progress/{activityId}": {
      "schema": "UserProgress",
      "description": "User activity progress"
    },
    "/users/{userId}/achievements/{badgeId}": {
      "schema": "UserAchievementDoc",
      "description": "User unlocked badges"
    },
    "/users/{userId}/pointsHistory/{txId}": {
      "schema": "PointTransactionDoc",
      "description": "Points transaction history log"
    },
    "/users/{userId}/dailyTips/{dateId}": {
      "schema": "DailyTipAnswerDoc",
      "description": "Student daily tip answer history"
    }
  }
}
