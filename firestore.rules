rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all outside explicit collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeacherEmail(email) {
      return email in [
        'imaginebycarla2023@gmail.com',
        'imaginebacarla2023@gmail.com',
        'prof.carla@escola.pt',
        'carla.oliveira@escola.pt'
      ];
    }

    function isAdmin() {
      return isSignedIn() && (
        isTeacherEmail(request.auth.token.email) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'])
      );
    }

    // 1. User Profiles and Subcollections
    match /users/{userId} {
      // Students can only read their own profile; teachers/admins can read all students for gradebook
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Student registration: role must be student with 0 initial points and NO credentials stored
      allow create: if (isOwner(userId) || isAdmin()) && (
        request.resource.data.role == 'student' &&
        request.resource.data.points == 0 &&
        request.resource.data.id == userId &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      );

      // Profile updates: cannot escalate role to admin/teacher; points bounded (0-6000); NO passwords
      allow update: if (isOwner(userId) || isAdmin()) && (
        request.resource.data.role != 'admin' &&
        request.resource.data.role != 'teacher' &&
        request.resource.data.points >= resource.data.points &&
        request.resource.data.points <= 6000 &&
        (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      );

      // Protect teacher accounts from deletion; only admin can delete students
      allow delete: if isAdmin() && (
        !isTeacherEmail(resource.data.email) &&
        resource.data.role != 'admin' &&
        resource.data.role != 'teacher'
      );

      // Progress subcollection: activity progress tracking under field validation
      match /progress/{activityId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if (isOwner(userId) || isAdmin()) && (
          request.resource.data.userId == userId &&
          request.resource.data.activityId == activityId &&
          request.resource.data.activityType in ['module', 'quiz', 'challenge'] &&
          request.resource.data.status in ['completed', 'in_progress'] &&
          request.resource.data.attempts >= 1 &&
          !('points' in request.resource.data) &&
          (!('percentage' in request.resource.data) || (request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100)) &&
          (!('bestPercentage' in request.resource.data) || (request.resource.data.bestPercentage >= 0 && request.resource.data.bestPercentage <= 100))
        );

        allow update: if (isOwner(userId) || isAdmin()) && (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.activityId == resource.data.activityId &&
          request.resource.data.activityType == resource.data.activityType &&
          request.resource.data.status in ['completed', 'in_progress'] &&
          request.resource.data.attempts >= resource.data.attempts &&
          !('points' in request.resource.data) &&
          (!('percentage' in request.resource.data) || (request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100)) &&
          (!('bestPercentage' in request.resource.data) || (
            request.resource.data.bestPercentage >= resource.data.bestPercentage &&
            request.resource.data.bestPercentage <= 100
          ))
        );

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Achievements subcollection: Student unlocks with known badges validation
      match /achievements/{badgeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && (
          badgeId in [
            'primeiros-passos', 'guardiao-digital', 'especialista-seguranca',
            'detetive-cibernetico', 'mestre-email', 'detetive-informacao',
            'mestre-pesquisa', 'tic-explorer', 'centuriao-pontos'
          ] &&
          request.resource.data.id == badgeId &&
          request.resource.data.pointsBonus >= 0 &&
          request.resource.data.pointsBonus <= 150
        );
        allow update: if false; // Badges are immutable once unlocked
        allow delete: if isAdmin();
      }

      // Points History subcollection: Point transactions strictly bounded
      match /pointsHistory/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        // Disallow arbitrary fabrication: points must be between 1 and 150 (single activity or badge bonus max)
        allow create: if (isOwner(userId) || isAdmin()) && (
          request.resource.data.userId == userId &&
          request.resource.data.points > 0 &&
          request.resource.data.points <= 150 &&
          request.resource.data.source in ['module', 'quiz', 'challenge', 'daily_tip', 'badge', 'activity']
        );
        allow update: if false; // Transaction ledger is immutable
        allow delete: if isAdmin();
      }

      // Daily Tips subcollection: Student daily tip answer sync across devices
      // ID must be a valid date format and points bounded to 50 max (bonus for correct answer)
      match /dailyTips/{dateId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && (
          request.resource.data.userId == userId &&
          request.resource.data.date == dateId &&
          request.resource.data.pointsEarned >= 0 &&
          request.resource.data.pointsEarned <= 50
        );
        // Do NOT allow overwriting or re-earning points if already answered
        allow update: if (isOwner(userId) || isAdmin()) && (
          resource.data.answered != true &&
          request.resource.data.userId == userId &&
          request.resource.data.pointsEarned <= 50
        );
        allow delete: if isAdmin();
      }
    }

    // 2. Public Leaderboard Profiles (Privacy-First: id, publicId, turma, role, points, counters)
    // Strictly forbid email, password, and real name
    match /publicProfiles/{userId} {
      allow read: if true;

      allow create: if (isOwner(userId) || isAdmin()) && (
        request.resource.data.role == 'student' &&
        request.resource.data.points == 0 &&
        !('email' in request.resource.data) &&
        !('name' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      );

      // Student points progression sync: bounded to valid platform score range (0-6000 XP)
      allow update: if (isOwner(userId) || isAdmin()) && (
        request.resource.data.role == 'student' &&
        request.resource.data.points >= resource.data.points &&
        request.resource.data.points <= 6000 &&
        !('email' in request.resource.data) &&
        !('name' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      );

      allow delete: if isAdmin() || (isOwner(userId) && resource.data.role == 'student');
    }

    // 3. System Configurations (Class list / Turmas, Pedagogical Theme Visibility, Health Checks)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
