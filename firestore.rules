rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Config / System settings (e.g. turmas list, theme visibility)
    match /config/{docId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Turmas collection
    match /turmas/{docId} {
      allow read, write: if true;
    }

    // User accounts, student accesses and profiles
    match /users/{userId} {
      allow read, write: if true;

      // Subcollection: Activity Progress
      match /progress/{activityId} {
        allow read, write: if true;
      }

      // Subcollection: Achievements / Badges
      match /achievements/{badgeId} {
        allow read, write: if true;
      }
    }

    // Direct access collection support (e.g. 'acessos', 'alunos')
    match /acessos/{docId} {
      allow read, write: if true;
    }

    match /alunos/{docId} {
      allow read, write: if true;
    }

    // Public Profiles (for ranking / leaderboard)
    match /publicProfiles/{userId} {
      allow read, write: if true;
    }

    // Fallback for any other document/collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

