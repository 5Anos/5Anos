rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles and Subcollections
    // Allows school students and teacher access across school devices
    match /users/{userId} {
      allow read, write: if true;

      match /progress/{activityId} {
        allow read, write: if true;
      }

      match /achievements/{badgeId} {
        allow read, write: if true;
      }

      match /pointsHistory/{txId} {
        allow read, write: if true;
      }
    }

    // 2. Public Leaderboard Profiles (Privacy-First: publicId, turma, points)
    match /publicProfiles/{userId} {
      allow read, write: if true;
    }

    // 3. System Configurations (Class list / Turmas, Pedagogical Theme Visibility)
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
