rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Coleção de Utilizadores (Alunos e Professora)
     * Permite aos alunos e professora gerir a sua conta e progresso
     * na nuvem de forma persistente.
     */
    match /users/{userId} {
      allow read, write: if true;

      match /progress/{activityId} {
        allow read, write: if true;
      }

      match /achievements/{badgeId} {
        allow read, write: if true;
      }

      match /pointsHistory/{transactionId} {
        allow read, write: if true;
      }

      match /dailyTips/{dateId} {
        allow read, write: if true;
      }
    }

    /*
     * Credenciais de autenticação (Hash e validação na nuvem)
     */
    match /credentials/{userId} {
      allow read, write: if true;
    }

    /*
     * Perfis Públicos e Ranking
     */
    match /publicProfiles/{userId} {
      allow read, write: if true;
    }

    /*
     * Configurações pedagógicas da plataforma (Turmas e visibilidade de temas/quizzes)
     */
    match /config/{configDoc} {
      allow read, write: if true;
    }

    /*
     * Regra padrão para quaisquer outros documentos
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
