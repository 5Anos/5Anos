rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config / System settings
    match /config/{docId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // User Private Profile & Subcollections
    match /users/{userId} {
      allow read, write: if true;

      // Subcollection: Activity Progress
      match /progress/{activityId} {
        allow read, write: if true;
      }

      // Subcollection: Achievements / Badges
      match /achievements/{badgeId} {
        allow read, write: if true;
      }
    }

    // Public Profiles (for ranking / leaderboard)
    match /publicProfiles/{userId} {
      allow read, write: if true;
    }
  }
}
