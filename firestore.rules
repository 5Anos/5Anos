rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'imaginebycarla2023@gmail.com' ||
        request.auth.token.email == 'imaginebacarla2023@gmail.com' ||
        request.auth.token.email == 'prof.carla@escola.pt' ||
        request.auth.token.email == 'carla.oliveira@escola.pt'
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. User Profiles and Subcollections
    match /users/{userId} {
      // User can read profiles; Admin can read all (essential for student login and teacher gradebook)
      allow read: if true;

      // Student registration: can only set role to student with 0 initial points and no credentials stored
      allow create: if (
        request.resource.data.role == 'student' &&
        request.resource.data.points == 0 &&
        request.resource.data.id == userId &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      ) || isAdmin();

      // Profile updates: cannot escalate role, points must be within legitimate range (0-6000), no passwords
      allow update: if (
        request.resource.data.role == resource.data.role &&
        request.resource.data.role != 'admin' &&
        request.resource.data.role != 'teacher' &&
        request.resource.data.points >= resource.data.points &&
        request.resource.data.points <= 6000 &&
        (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      ) || isAdmin();

      // Allow deletion of student profiles for teacher admin management
      allow delete: if isAdmin() || resource.data.role == 'student';

      // Progress subcollection: student can track their activity progress under strict field validation
      match /progress/{activityId} {
        allow read: if true;

        allow create: if (
          request.resource.data.userId == userId &&
          request.resource.data.activityId == activityId &&
          request.resource.data.activityType in ['module', 'quiz', 'challenge'] &&
          request.resource.data.status in ['completed', 'in_progress'] &&
          request.resource.data.attempts >= 1 &&
          !('points' in request.resource.data) &&
          (!('percentage' in request.resource.data) || (request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100)) &&
          (!('bestPercentage' in request.resource.data) || (request.resource.data.bestPercentage >= 0 && request.resource.data.bestPercentage <= 100))
        ) || isAdmin();

        allow update: if (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.activityId == resource.data.activityId &&
          request.resource.data.activityType == resource.data.activityType &&
          request.resource.data.status in ['completed', 'in_progress'] &&
          request.resource.data.attempts >= resource.data.attempts &&
          !('points' in request.resource.data) &&
          (!('percentage' in request.resource.data) || (request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100)) &&
          (!('bestPercentage' in request.resource.data) || (
            request.resource.data.bestPercentage >= resource.data.bestPercentage &&
            request.resource.data.bestPercentage <= 100
          ))
        ) || isAdmin();

        allow delete: if true;
      }

      // Achievements subcollection: Student can read and unlock achievements; admin can manage
      match /achievements/{badgeId} {
        allow read: if true;
        allow write: if true;
      }

      // Points History subcollection: Student can read and log transactions; admin can manage
      match /pointsHistory/{txId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 2. Public Leaderboard Profiles (Privacy-First: id, publicId, turma, role, points)
    match /publicProfiles/{userId} {
      allow read: if true;

      allow create: if (
        request.resource.data.role == 'student' &&
        request.resource.data.points == 0 &&
        !('email' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      ) || isAdmin();

      // Student points progression sync: bounded to valid platform score range (0-6000 XP)
      allow update: if (
        request.resource.data.role == resource.data.role &&
        request.resource.data.points >= resource.data.points &&
        request.resource.data.points <= 6000 &&
        !('email' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      ) || isAdmin();

      allow delete: if true;
    }

    // 3. System Configurations (Class list / Turmas, Pedagogical Theme Visibility)
    // Turmas and pedagogical settings can be managed by the teacher
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
