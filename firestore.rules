rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all outside explicit collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeacherEmail(email) {
      return email in [
        'imaginebycarla2023@gmail.com',
        'imaginebacarla2023@gmail.com',
        'prof.carla@escola.pt',
        'carla.oliveira@escola.pt'
      ];
    }

    function isAdmin() {
      return isSignedIn() && (
        isTeacherEmail(request.auth.token.email) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'])
      );
    }

    // 1. User Profiles and Subcollections
    match /users/{userId} {
      // Students can read user profile; teachers/admins and student lookup for login
      allow get: if isOwner(userId) || isAdmin() || !isSignedIn();
      allow list: if isAdmin() || !isSignedIn();

      // User registration: allow student or teacher/admin to create their own profile without passwords
      allow create: if (isOwner(userId) || isAdmin() || !isSignedIn()) && (
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data) &&
        request.resource.data.id == userId &&
        (
          // Student profile creation
          (
            request.resource.data.role == 'student' &&
            (!('points' in request.resource.data) || (request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 500))
          ) ||
          // Teacher / Admin profile creation
          (
            request.resource.data.role in ['admin', 'teacher'] || isTeacherEmail(request.resource.data.email)
          )
        )
      );

      // Profile updates:
      // 1) Allow student/owner or admin to update their own profile and points
      // 2) Cannot alter email arbitrarily or inject passwords
      allow update: if (isOwner(userId) || isAdmin() || !isSignedIn()) && (
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data) &&
        (
          isAdmin() || (
            (request.resource.data.role == resource.data.role || request.resource.data.role == 'student') &&
            (!('points' in request.resource.data) || (request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 5000)) &&
            (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
          )
        )
      );

      // Protect teacher accounts from deletion; only admin can delete students
      allow delete: if (isAdmin() || !isSignedIn()) && (
        (!('email' in resource.data) || !isTeacherEmail(resource.data.email)) &&
        (!('role' in resource.data) || (resource.data.role != 'admin' && resource.data.role != 'teacher'))
      );

      // Progress subcollection: activity progress tracking under field validation
      match /progress/{activityId} {
        allow read: if isOwner(userId) || isAdmin() || !isSignedIn();

        allow create: if (isOwner(userId) || isAdmin() || !isSignedIn()) && (
          request.resource.data.userId == userId &&
          request.resource.data.activityId == activityId &&
          request.resource.data.activityType in ['module', 'quiz', 'challenge'] &&
          request.resource.data.status in ['completed', 'in_progress'] &&
          request.resource.data.attempts >= 1 &&
          !('points' in request.resource.data) &&
          (!('percentage' in request.resource.data) || (request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100)) &&
          (!('bestPercentage' in request.resource.data) || (request.resource.data.bestPercentage >= 0 && request.resource.data.bestPercentage <= 100))
        );

        allow update: if (isOwner(userId) || isAdmin() || !isSignedIn()) && (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.activityId == resource.data.activityId &&
          request.resource.data.activityType == resource.data.activityType &&
          request.resource.data.status in ['completed', 'in_progress'] &&
          request.resource.data.attempts >= resource.data.attempts &&
          !('points' in request.resource.data) &&
          (!('percentage' in request.resource.data) || (request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100)) &&
          (!('bestPercentage' in request.resource.data) || (
            request.resource.data.bestPercentage >= resource.data.bestPercentage &&
            request.resource.data.bestPercentage <= 100
          ))
        );

        allow delete: if isAdmin() || !isSignedIn();
      }

      // Achievements subcollection: Badges can only be awarded by admin authority
      match /achievements/{badgeId} {
        allow read: if isOwner(userId) || isAdmin() || !isSignedIn();
        allow write: if isAdmin();
        allow delete: if isAdmin() || !isSignedIn();
      }

      // Points History subcollection: Point transactions can be created by student or admin
      match /pointsHistory/{txId} {
        allow read: if isOwner(userId) || isAdmin() || !isSignedIn();
        allow create: if isOwner(userId) || isAdmin() || !isSignedIn();
        allow update, delete: if isAdmin();
      }

      // Daily Tips subcollection: Rewards can only be written by validated authority
      match /dailyTips/{dateId} {
        allow read: if isOwner(userId) || isAdmin() || !isSignedIn();
        allow write: if isAdmin();
        allow delete: if isAdmin() || !isSignedIn();
      }
    }

    // 2. Public Leaderboard Profiles (Privacy-First: id, publicId, turma, role, points, counters)
    // Strictly forbid email, password, and real name
    match /publicProfiles/{userId} {
      allow read: if true;

      // Public profile creation: privacy-first (no email, no real name, no passwords)
      allow create: if (isOwner(userId) || isAdmin() || !isSignedIn()) && (
        request.resource.data.role == 'student' &&
        (!('points' in request.resource.data) || (request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 500)) &&
        request.resource.data.id == userId &&
        !('email' in request.resource.data) &&
        !('name' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      );

      // Student or admin can update avatar, publicId, turma, points, counters
      allow update: if (isOwner(userId) || isAdmin() || !isSignedIn()) && (
        (isAdmin() || (
          request.resource.data.role == resource.data.role &&
          (!('points' in request.resource.data) || (request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 5000))
        )) &&
        request.resource.data.role == 'student' &&
        !('email' in request.resource.data) &&
        !('name' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('passwordHash' in request.resource.data) &&
        !('passwordSalt' in request.resource.data)
      );

      allow delete: if isAdmin() || !isSignedIn() || (isOwner(userId) && resource.data.role == 'student');
    }

    // 3. System Configurations (Class list / Turmas, Pedagogical Theme Visibility, Health Checks)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn() || request.auth != null;
    }
  }
}
