rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Configurações globais (Turmas, Visibilidade de Temas e Quizzes)
    match /config/{configDoc} {
      allow read, write: if true;
    }

    // Coleção de Utilizadores e Subcoleções (Progresso, Dicas Diárias, Conquistas)
    match /users/{userId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Perfis Públicos e Rankings
    match /publicProfiles/{userId} {
      allow read, write: if true;
    }

    // Credenciais de Acesso (Hashes PBKDF2 e Salts)
    match /credentials/{userId} {
      allow read, write: if true;
    }

    // Sessões e Tokens Revogados
    match /revokedTokens/{tokenId} {
      allow read, write: if true;
    }

    // Regra padrão de fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
